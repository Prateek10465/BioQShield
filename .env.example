# Copy to .env, or better: run `python scripts/make_env.py`, which fills these with fresh random secrets.
# Never commit a real .env. Every value below is a placeholder.

# 64 hex chars. Pre-shared bootstrap secret that authenticates the very first QKD session. Replaced
# by QKD-derived keys after that, but it protects session one, so keep it secret and the same on both sides.
QKD_AUTH_KEY=

# 64 hex chars each. Encrypt each hospital's database (records, keys) and sign its audit log.
# Lose it and that hospital's data cannot be read; leak it and the database file can be read.
QKD_MASTER_KEY_A=
QKD_MASTER_KEY_B=

# First admin account for each hospital (username: admin). Use 10+ characters.
ADMIN_PASSWORD_A=
ADMIN_PASSWORD_B=

# ETSI mode only (docker-compose.etsi.yml): the API key each hospital presents to the key manager.
KME_API_KEY_A=
KME_API_KEY_B=

# Optional
# HOSPITAL_A_NAME=Hospital A
# HOSPITAL_B_NAME=Hospital B
# QKD_KEY_TTL=3600        seconds an unused key stays valid
# QKD_QUBITS=16384        qubits per BB84 session
# Demo logins (clinician "dr.rao" and "auditor") for a demo machine only:
# DEMO_USERS=1
# CLINICIAN_PASSWORD=
# AUDITOR_PASSWORD=
